#!/usr/bin/env bash
# bin/check-workflow - Isolated Flowable 8.0.0 compatibility spike validation.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

COMPOSE_PROJECT="alixar-workflow-check-$$-${RANDOM}${RANDOM}"
COMPOSE=(docker compose -p "${COMPOSE_PROJECT}" -f compose.workflow.yaml)

for resource in container network volume; do
    resource_args=(ls -q)
    if [[ "${resource}" == container ]]; then resource_args+=(--all); fi
    existing=$(docker "${resource}" "${resource_args[@]}" --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}")
    if [[ -n "${existing}" ]]; then
        echo "ERROR: Project already exists: ${COMPOSE_PROJECT}" >&2
        exit 1
    fi
done

cleanup() {
    local exit_code=$? cleanup_code=0
    trap - EXIT
    if ! "${COMPOSE[@]}" down --volumes; then
        echo "ERROR: Cleanup failed for ${COMPOSE_PROJECT}" >&2
        cleanup_code=1
    fi
    for resource in container network volume; do
        local remaining
        local -a resource_args=(ls -q)
        if [[ "${resource}" == container ]]; then resource_args+=(--all); fi
        if remaining=$(docker "${resource}" "${resource_args[@]}" --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}"); then
            if [[ -n "${remaining}" ]]; then
                echo "ERROR: Remaining ${resource} resources for ${COMPOSE_PROJECT}: ${remaining}" >&2
                cleanup_code=1
            fi
        else
            cleanup_code=1
        fi
    done
    if [[ ${exit_code} -ne 0 ]]; then
        echo "ERROR: Workflow validation failed with exit code ${exit_code}" >&2
    else
        exit_code=${cleanup_code}
        if [[ ${exit_code} -eq 0 ]]; then
            echo "=== Workflow compatibility checks passed; ${COMPOSE_PROJECT} cleaned ==="
        fi
    fi
    exit "${exit_code}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "=== Alixar workflow compatibility spike: ${COMPOSE_PROJECT} ==="
echo "Building test image..."
"${COMPOSE[@]}" build workflow-test

echo "Starting isolated PostgreSQL 18.6 for the workflow spike..."
"${COMPOSE[@]}" up --no-build --detach --wait --wait-timeout 120 workflow-database

echo "Running FlowableCompatibilityIT and FlowableIsolationIT..."
"${COMPOSE[@]}" run --rm --no-deps workflow-test

# Cleanup and final success reporting happen in the EXIT trap.
