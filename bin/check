#!/usr/bin/env bash
# bin/check — Complete local validation authority for Alixar

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

echo "=== Alixar local validation ==="
echo ""

# 1. Build image (runs tests in build stage)
echo "[1/5] Building image (includes tests)..."
docker compose build app
echo ""

# 2. Start all services (database + app)
echo "[2/5] Starting services..."
export ALIXAR_JAVA_PORT="${ALIXAR_JAVA_PORT:-48081}"
export ALIXAR_DB_NAME="${ALIXAR_DB_NAME:-alixar}"
export ALIXAR_DB_USER="${ALIXAR_DB_USER:-alixar}"
export ALIXAR_DB_PASSWORD="${ALIXAR_DB_PASSWORD:-alixar}"
docker compose up --detach --wait --wait-timeout 120
echo ""

# 3. Verify database is healthy
echo "[3/5] Verifying PostgreSQL health..."
for i in {1..30}; do
    if docker compose exec -T database pg_isready -U "${ALIXAR_DB_USER}" -d "${ALIXAR_DB_NAME}" >/dev/null 2>&1; then
        echo "PostgreSQL health check passed"
        break
    fi
    if [[ $i -eq 30 ]]; then
        echo "ERROR: PostgreSQL did not become healthy within 60 seconds" >&2
        docker compose logs database
        exit 1
    fi
    sleep 2
done
echo ""

# 4. Verify Flyway schema history table exists
echo "[4/5] Verifying Flyway initialization..."
for i in {1..15}; do
    if docker compose exec -T database psql -U "${ALIXAR_DB_USER}" -d "${ALIXAR_DB_NAME}" -c "SELECT 1 FROM flyway_schema_history LIMIT 1" >/dev/null 2>&1; then
        echo "Flyway schema history table verified"
        break
    fi
    if [[ $i -eq 15 ]]; then
        echo "ERROR: Flyway schema history table not found" >&2
        docker compose logs app
        exit 1
    fi
    sleep 2
done
echo ""

# 5. Verify health endpoint
echo "[5/5] Verifying /health endpoint..."
HEALTH_URL="http://127.0.0.1:${ALIXAR_JAVA_PORT}/health"
for i in {1..30}; do
    if response=$(curl --silent --show-error --max-time 5 \
        --header 'Accept: application/json' \
        --write-out '\n%{http_code}\n%{content_type}' "${HEALTH_URL}" 2>/dev/null); then
        http_code=$(echo "${response}" | tail -n2 | head -n1)
        content_type=$(echo "${response}" | tail -n1)
        body=$(echo "${response}" | head -n -2)
        if [[ "${http_code}" == "200" ]] && \
           [[ "${content_type,,}" =~ ^application/json([[:space:]]*;.*)?$ ]] && \
           [[ "${body}" == '{"status":"ok"}' ]]; then
            echo "Health check passed: ${HEALTH_URL}"
            break
        fi
    fi
    if [[ $i -eq 30 ]]; then
        echo "ERROR: /health did not become available within 60 seconds" >&2
        docker compose logs app
        exit 1
    fi
    sleep 2
done
echo ""

# 6. Cleanup
echo "[6/6] Cleaning up..."
docker compose down --remove-orphans --volumes
echo ""

echo "=== All checks passed ==="