#!/usr/bin/env bash
# bin/check — Complete local validation authority for Alixar

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

# A fresh namespace and Docker-assigned port keep checks separate from development.
COMPOSE_PROJECT="alixar-check-$$-${RANDOM}${RANDOM}"
export ALIXAR_JAVA_PORT="${ALIXAR_JAVA_PORT:-0}"
COMPOSE=(docker compose -p "${COMPOSE_PROJECT}" -f compose.yaml -f compose.check.yaml)

# Refuse ownership of any pre-existing resources before installing the cleanup trap.
for resource in container network volume; do
    resource_args=(ls -q)
    if [[ "${resource}" == container ]]; then resource_args+=(--all); fi
    existing=$(docker "${resource}" "${resource_args[@]}" --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}")
    if [[ -n "${existing}" ]]; then
        echo "ERROR: Project already exists: ${COMPOSE_PROJECT}" >&2
        exit 1
    fi
done

cleanup() {
    local exit_code=$? cleanup_code=0
    trap - EXIT
    if ! "${COMPOSE[@]}" down --volumes; then
        echo "ERROR: Cleanup failed for ${COMPOSE_PROJECT}" >&2
        cleanup_code=1
    fi
    for resource in container network volume; do
        local remaining
        local -a resource_args=(ls -q)
        if [[ "${resource}" == container ]]; then resource_args+=(--all); fi
        if remaining=$(docker "${resource}" "${resource_args[@]}" --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}"); then
            if [[ -n "${remaining}" ]]; then
                echo "ERROR: Remaining ${resource} resources for ${COMPOSE_PROJECT}: ${remaining}" >&2
                cleanup_code=1
            fi
        else
            cleanup_code=1
        fi
    done
    if [[ ${exit_code} -ne 0 ]]; then
        echo "ERROR: Validation failed with exit code ${exit_code}" >&2
    else
        exit_code=${cleanup_code}
        if [[ ${exit_code} -eq 0 ]]; then
            echo "=== All checks passed; ${COMPOSE_PROJECT} cleaned ==="
        fi
    fi
    exit "${exit_code}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "=== Alixar local validation: ${COMPOSE_PROJECT} ==="
echo "Building current code and running component tests..."
"${COMPOSE[@]}" build app persistence-test

echo "Starting isolated PostgreSQL and application..."
"${COMPOSE[@]}" up --no-build --detach --wait --wait-timeout 120 app

# The integration test checks the real Boot beans, Flyway V1, SELECT 1 through
# jOOQ, and the authentication schema constraints.
echo "Verifying PostgreSQL/Flyway/jOOQ integration..."
"${COMPOSE[@]}" run --rm --no-deps persistence-test

APP_ADDRESS=$("${COMPOSE[@]}" port app 8080)
HEALTH_URL="http://${APP_ADDRESS}/health"

# Verify the unchanged canonical health response.
echo "Verifying /health endpoint..."
for i in {1..30}; do
    if response=$(curl --silent --show-error --max-time 5 \
        --header 'Accept: application/json' \
        --write-out '\n%{http_code}\n%{content_type}' "${HEALTH_URL}" 2>/dev/null); then
        http_code=$(echo "${response}" | tail -n2 | head -n1)
        content_type=$(echo "${response}" | tail -n1)
        body=$(echo "${response}" | head -n -2)
        if [[ "${http_code}" == "200" ]] && \
           [[ "${content_type,,}" =~ ^application/json([[:space:]]*;.*)?$ ]] && \
           [[ "${body}" == '{"status":"ok"}' ]]; then
            echo "Health check passed: ${HEALTH_URL}"
            break
        fi
    fi
    if [[ $i -eq 30 ]]; then
        echo "ERROR: /health did not become available within 60 seconds" >&2
        "${COMPOSE[@]}" logs app
        exit 1
    fi
    sleep 2
done
echo ""

# Cleanup and final success reporting happen in the EXIT trap.
