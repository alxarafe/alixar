#!/usr/bin/env bash
# bin/check-reference — Real compatibility validation against dolibarr-reference
# Verifies the observed Dolibarr 24.0.1 behavior remains reproducible and that
# Alixar's canonical Contact runtime no longer depends on Dolibarr.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ALIXAR_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
REF_ROOT="${ALIXAR_ROOT}/../dolibarr-reference"

export ALIXAR_JAVA_PORT="${ALIXAR_JAVA_PORT:-0}"
REF_PORT="${DOLIBARR_REFERENCE_PORT:-48240}"
REF_BASE_URL="http://127.0.0.1:${REF_PORT}"

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*"; }

COMPOSE_PROJECT="alixar-reference-check-$$-${RANDOM}${RANDOM}"
COMPOSE=(docker compose -p "${COMPOSE_PROJECT}" -f "${ALIXAR_ROOT}/compose.yaml")
for resource in container network volume; do
    resource_args=(ls -q)
    if [[ "${resource}" == container ]]; then resource_args+=(--all); fi
    existing=$(docker "${resource}" "${resource_args[@]}" --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}")
    if [[ -n "${existing}" ]]; then
        log_error "Project already exists: ${COMPOSE_PROJECT}"
        exit 1
    fi
done

ALIXAR_STARTED=false
cleanup() {
    local exit_code=$? cleanup_code=0
    trap - EXIT
    if [[ "${ALIXAR_STARTED}" == true ]]; then
        log_info "Cleaning up ${COMPOSE_PROJECT}..."
        if ! "${COMPOSE[@]}" down --volumes; then
            log_error "Cleanup failed for ${COMPOSE_PROJECT}"
            cleanup_code=1
        fi
        for resource in container network volume; do
            local remaining
            local -a resource_args=(ls -q)
            if [[ "${resource}" == container ]]; then resource_args+=(--all); fi
            if remaining=$(docker "${resource}" "${resource_args[@]}" --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}"); then
                if [[ -n "${remaining}" ]]; then
                    log_error "Remaining ${resource} resources: ${remaining}"
                    cleanup_code=1
                fi
            else
                cleanup_code=1
            fi
        done
    fi
    if [[ ${exit_code} -eq 0 ]]; then
        exit_code=${cleanup_code}
        if [[ ${exit_code} -eq 0 ]]; then
            log_info "Reference check PASSED; ${COMPOSE_PROJECT} cleaned"
        fi
    else
        log_error "Reference check failed with exit code ${exit_code}"
    fi
    exit "${exit_code}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

log_info "Checking for sibling dolibarr-reference repository..."
if [[ ! -d "${REF_ROOT}" || ! -f "${REF_ROOT}/bin/up" ]]; then
    log_error "dolibarr-reference not found at ${REF_ROOT}"
    exit 1
fi
log_info "Found dolibarr-reference at ${REF_ROOT}"

log_info "Starting dolibarr-reference environment..."
cd "${REF_ROOT}"
COMPOSE_PROJECT_NAME=dolibarr-reference ./bin/up

log_info "Loading dolibarr-reference configuration..."
# shellcheck source=/dev/null
source "${REF_ROOT}/.env"
if [[ -z "${DOLIBARR_REFERENCE_API_KEY:-}" ]]; then
    log_error "DOLIBARR_REFERENCE_API_KEY not set in ${REF_ROOT}/.env after startup"
    exit 1
fi
REF_API_KEY="${DOLIBARR_REFERENCE_API_KEY}"

log_info "Creating and reading a contact directly in Dolibarr..."
REF_EMAIL="alixar.reference.$$.${RANDOM}@example.test"
REF_CREATE_RESPONSE=$(curl -s -X POST "${REF_BASE_URL}/api/index.php/contacts" \
    -H "DOLAPIKEY: ${REF_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "{\"lastname\":\"Reference\",\"firstname\":\"Harness\",\"email\":\"${REF_EMAIL}\"}")

REF_CONTACT_ID=$(echo "${REF_CREATE_RESPONSE}" | sed 's/[^0-9]//g')
if [[ -z "${REF_CONTACT_ID}" ]] || [[ ! "${REF_CONTACT_ID}" =~ ^[0-9]+$ ]]; then
    log_error "Failed to create contact in Dolibarr: ${REF_CREATE_RESPONSE}"
    exit 1
fi

REF_CONTACT=$(curl -s "${REF_BASE_URL}/api/index.php/contacts/${REF_CONTACT_ID}" \
    -H "DOLAPIKEY: ${REF_API_KEY}" \
    -H "Accept: application/json")
for legacy_field in '"id"' '"lastname"' '"firstname"' '"email"'; do
    if ! echo "${REF_CONTACT}" | grep -q "${legacy_field}"; then
        log_error "Dolibarr reference response is missing ${legacy_field}: ${REF_CONTACT}"
        exit 1
    fi
done
if ! echo "${REF_CONTACT}" | grep -q "\"email\":[[:space:]]*\"${REF_EMAIL}\""; then
    log_error "Dolibarr reference contact email mismatch: ${REF_CONTACT}"
    exit 1
fi
log_info "Dolibarr reference contact create/read verified (ID ${REF_CONTACT_ID})"

cd "${ALIXAR_ROOT}"
log_info "Building current Alixar code for ${COMPOSE_PROJECT}..."
"${COMPOSE[@]}" build app
BUILT_IMAGE=$(docker image inspect "${COMPOSE_PROJECT}-app" --format '{{.Id}}')
log_info "Starting isolated Alixar without Dolibarr runtime configuration..."
ALIXAR_STARTED=true
"${COMPOSE[@]}" up --no-build --detach --wait --wait-timeout 120 app
APP_CONTAINER=$("${COMPOSE[@]}" ps -q app)
RUNNING_IMAGE=$(docker inspect "${APP_CONTAINER}" --format '{{.Image}}')
if [[ "${RUNNING_IMAGE}" != "${BUILT_IMAGE}" ]]; then
    log_error "Running Alixar image differs from the image just built"
    exit 1
fi
if "${COMPOSE[@]}" exec -T app env | grep -q '^ALIXAR_DOLIBARR_'; then
    log_error "Alixar runtime still receives Dolibarr configuration"
    exit 1
fi
APP_ADDRESS=$("${COMPOSE[@]}" port app 8080)
ALIXAR_PORT="${APP_ADDRESS##*:}"
ALIXAR_BASE="http://127.0.0.1:${ALIXAR_PORT}"

log_info "Waiting for Alixar /health..."
for i in {1..30}; do
    if response=$(curl --silent --show-error --max-time 5 \
        --header 'Accept: application/json' \
        --write-out '\n%{http_code}\n%{content_type}' \
        "${ALIXAR_BASE}/health" 2>/dev/null); then
        http_code=$(echo "${response}" | tail -n2 | head -n1)
        content_type=$(echo "${response}" | tail -n1)
        body=$(echo "${response}" | head -n -2)
        if [[ "${http_code}" == "200" ]] && \
           [[ "${content_type,,}" =~ ^application/json([[:space:]]*;.*)?$ ]] && \
           [[ "${body}" == '{"status":"ok"}' ]]; then
            log_info "Alixar health check passed"
            break
        fi
    fi
    if [[ $i -eq 30 ]]; then
        log_error "Alixar /health did not become available within 60 seconds"
        "${COMPOSE[@]}" logs app
        exit 1
    fi
    sleep 2
done

log_info "Creating a standalone Contact through the canonical API..."
CREATE_PAYLOAD='{"lastName":"Native","firstName":"Reference","email":"alixar.native@example.test"}'
CREATE_RESPONSE=$(curl -i -s -w "\n%{http_code}" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json" \
    -d "${CREATE_PAYLOAD}" \
    "${ALIXAR_BASE}/api/contacts")
CREATE_HTTP_CODE=$(echo "${CREATE_RESPONSE}" | tail -n1)
CREATE_HEADERS_AND_BODY=$(echo "${CREATE_RESPONSE}" | head -n -1)
CREATE_BODY=$(echo "${CREATE_HEADERS_AND_BODY}" | sed -n '/^\r*$/,$p' | tail -n +2)

if [[ "${CREATE_HTTP_CODE}" != "201" ]]; then
    log_error "Alixar CREATE returned HTTP ${CREATE_HTTP_CODE}, expected 201"
    log_error "Response: ${CREATE_BODY}"
    exit 1
fi
NATIVE_CONTACT_ID=$(echo "${CREATE_BODY}" | sed -n 's/.*"id":[[:space:]]*\([0-9]*\).*/\1/p')
if [[ -z "${NATIVE_CONTACT_ID}" ]] || [[ ! "${NATIVE_CONTACT_ID}" =~ ^[0-9]+$ ]]; then
    log_error "Failed to parse created native contact ID: ${CREATE_BODY}"
    exit 1
fi
if ! echo "${CREATE_HEADERS_AND_BODY}" | grep -qi "Location: /api/contacts/${NATIVE_CONTACT_ID}"; then
    log_error "Location header missing or incorrect"
    exit 1
fi
log_info "Native contact created with ID ${NATIVE_CONTACT_ID}"

GET_RESPONSE=$(curl -s -w "\n%{http_code}" \
    -H "Accept: application/json" \
    "${ALIXAR_BASE}/api/contacts/${NATIVE_CONTACT_ID}")
GET_HTTP_CODE=$(echo "${GET_RESPONSE}" | tail -n1)
GET_BODY=$(echo "${GET_RESPONSE}" | head -n -1)
if [[ "${GET_HTTP_CODE}" != "200" ]]; then
    log_error "Alixar GET returned HTTP ${GET_HTTP_CODE}, expected 200"
    log_error "Response: ${GET_BODY}"
    exit 1
fi
for canonical_field in '"id"' '"lastName"' '"firstName"' '"email"' '"thirdPartyId"'; do
    if ! echo "${GET_BODY}" | grep -q "${canonical_field}"; then
        log_error "Canonical response is missing ${canonical_field}: ${GET_BODY}"
        exit 1
    fi
done
if ! echo "${GET_BODY}" | grep -q '"lastName":[[:space:]]*"Native"'; then
    log_error "Native contact lastName mismatch: ${GET_BODY}"
    exit 1
fi
if ! echo "${GET_BODY}" | grep -q '"thirdPartyId":[[:space:]]*null'; then
    log_error "Standalone contact thirdPartyId must be null: ${GET_BODY}"
    exit 1
fi
for legacy_field in '"lastname"' '"firstname"' '"fk_soc"' '"socid"' '"socname"' '"statut"'; do
    if echo "${GET_BODY}" | grep -q "${legacy_field}"; then
        log_error "Legacy field ${legacy_field} leaked into the canonical response"
        exit 1
    fi
done
log_info "Native canonical Contact create/read verified without Dolibarr"

log_info "Verifying invalid third-party references are rejected natively..."
INVALID_RESPONSE=$(curl -s -w "\n%{http_code}" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json" \
    -d '{"lastName":"Invalid","thirdPartyId":999999999}' \
    "${ALIXAR_BASE}/api/contacts")
INVALID_HTTP_CODE=$(echo "${INVALID_RESPONSE}" | tail -n1)
INVALID_BODY=$(echo "${INVALID_RESPONSE}" | head -n -1)
if [[ "${INVALID_HTTP_CODE}" != "422" ]]; then
    log_error "Expected 422 for invalid third-party reference, got ${INVALID_HTTP_CODE}"
    log_error "Response: ${INVALID_BODY}"
    exit 1
fi
if ! echo "${INVALID_BODY}" | grep -q '"code":[[:space:]]*"CONTACT_INVALID_THIRD_PARTY_REFERENCE"'; then
    log_error "Unexpected invalid third-party error code: ${INVALID_BODY}"
    exit 1
fi
log_info "Invalid third-party reference correctly rejected with 422"

log_info "Verifying missing Contact returns canonical 404..."
NOT_FOUND_RESPONSE=$(curl -s -w "\n%{http_code}" \
    -H "Accept: application/json" \
    "${ALIXAR_BASE}/api/contacts/999999999")
NOT_FOUND_HTTP_CODE=$(echo "${NOT_FOUND_RESPONSE}" | tail -n1)
NOT_FOUND_BODY=$(echo "${NOT_FOUND_RESPONSE}" | head -n -1)
if [[ "${NOT_FOUND_HTTP_CODE}" != "404" ]]; then
    log_error "Expected 404 for missing contact, got ${NOT_FOUND_HTTP_CODE}"
    exit 1
fi
if ! echo "${NOT_FOUND_BODY}" | grep -q '"code":[[:space:]]*"CONTACT_NOT_FOUND"'; then
    log_error "Unexpected missing-contact error code: ${NOT_FOUND_BODY}"
    exit 1
fi
log_info "Missing Contact correctly rejected with 404"

log_info "Reference environment left running at ${REF_BASE_URL}"
log_info "To reset: cd ${REF_ROOT} && ./bin/reset"
log_info "Reference contact ID: ${REF_CONTACT_ID}"
log_info "Native Alixar contact ID: ${NATIVE_CONTACT_ID}"

exit 0
