#!/usr/bin/env bash
# bin/test — Run tests in Docker environment

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

echo "Running tests in Docker (via build stage)..."

# Build the image which runs tests in the build stage
docker compose build app