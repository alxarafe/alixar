#!/usr/bin/env bash
# bin/up — Start Alixar development environment

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${PROJECT_ROOT}"

export ALIXAR_JAVA_PORT="${ALIXAR_JAVA_PORT:-48081}"

echo "Starting Alixar on http://127.0.0.1:${ALIXAR_JAVA_PORT}"

docker compose up --build --detach

echo "Alixar is starting. Access health at http://127.0.0.1:${ALIXAR_JAVA_PORT}/health"
echo "Logs: docker compose logs -f"