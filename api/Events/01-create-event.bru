meta {
  name: 01-create-event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiBase}}/events
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Llamada Presentación Alixar",
    "typeCode": "AC_TEL",
    "dateStart": "2026-04-12 10:00:00",
    "dateEnd": "2026-04-12 11:30:00",
    "percentage": 100,
    "note": "Reunión súper satisfactoria con el cliente.",
    "assignedUserId": 1
  }
}

tests {
  test("Crea Evento exitoso", function() {
    expect([200, 201]).to.include(res.getStatus());
  });
  
  test("Devuelve id", function() {
    const data = res.getBody();
    if (typeof data === 'object' && data.id) {
       expect(data.id).to.be.above(0);
       bru.setEnvVar("testEventId", data.id);
    } else {
       expect(data).to.be.above(0);
       bru.setEnvVar("testEventId", data);
    }
  });
}
