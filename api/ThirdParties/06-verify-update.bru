meta {
  name: 06 - Verificar Actualización
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}{{apiBase}}/thirdparties/{{testThirdPartyId}}
  body: none
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Accept: application/json
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Nombre actualizado", function() {
    const body = res.getBody();
    const name = body.name || body.nom;
    expect(name).to.equal("BrunoTest Actualizado S.L.");
  });

  test("Ciudad actualizada a Barcelona", function() {
    const body = res.getBody();
    expect(body.town).to.equal("Barcelona");
  });

  test("Teléfono actualizado", function() {
    const body = res.getBody();
    expect(body.phone).to.equal("915555555");
  });
}
