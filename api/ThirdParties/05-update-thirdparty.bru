meta {
  name: 05 - Actualizar Tercero
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}{{apiBase}}/thirdparties/{{testThirdPartyId}}
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "BrunoTest Actualizado S.L.",
    "name_alias": "BrunoUpdated",
    "phone": "915555555",
    "town": "Barcelona"
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Respuesta tiene el objeto actualizado", function() {
    const body = res.getBody();
    // Dolibarr devuelve el objeto completo tras PUT
    if (typeof body === 'object' && body !== null) {
      const name = body.name || body.nom;
      if (name) {
        expect(name).to.equal("BrunoTest Actualizado S.L.");
      }
    }
  });
}
