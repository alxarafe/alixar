meta {
  name: 02 - Obtener Tercero por ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}{{apiBase}}/thirdparties/{{testThirdPartyId}}
  body: none
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Accept: application/json
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Tiene campo 'id' o 'rowid'", function() {
    const body = res.getBody();
    const hasId = body.id !== undefined || body.rowid !== undefined;
    expect(hasId).to.be.true;
  });

  test("Nombre es 'BrunoTest S.L.'", function() {
    const body = res.getBody();
    // Dolibarr usa 'name' en la respuesta (limpia 'nom' → 'name')
    const name = body.name || body.nom;
    expect(name).to.equal("BrunoTest S.L.");
  });

  test("Tiene campo 'status'", function() {
    const body = res.getBody();
    expect(body).to.have.property("status");
  });

  test("Tiene campo 'client'", function() {
    const body = res.getBody();
    expect(body).to.have.property("client");
  });

  test("Tiene campo 'address'", function() {
    const body = res.getBody();
    expect(body).to.have.property("address");
  });

  test("Tiene campo 'town'", function() {
    const body = res.getBody();
    expect(body).to.have.property("town");
  });

  test("Tiene campo 'email'", function() {
    const body = res.getBody();
    expect(body).to.have.property("email");
    expect(body.email).to.equal("test@brunotest.es");
  });

  test("Tiene campo 'phone'", function() {
    const body = res.getBody();
    expect(body).to.have.property("phone");
  });
}
