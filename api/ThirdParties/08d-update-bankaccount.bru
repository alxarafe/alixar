meta {
  name: 03-update-bankaccount
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}{{apiBase}}/thirdparties/{{testThirdPartyId}}/bankaccounts/{{testBankAccountId}}
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "bank": "BBVA"
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Banco actualizado a BBVA", function() {
    expect(res.getBody().bank).to.equal("BBVA");
  });
}
