meta {
  name: 01-create-project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiBase}}/projects
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Migración Arquitectura Hexagonal",
    "ref": "PRJ-HEX-01",
    "socid": 1
  }
}

tests {
  test("Crea Proyecto exitoso", function() {
    expect([200, 201]).to.include(res.getStatus());
  });
  
  test("Devuelve id", function() {
    const data = res.getBody();
    if (typeof data === 'object' && data.id) {
       expect(data.id).to.be.above(0);
       bru.setEnvVar("testProjectId", data.id);
    } else {
       expect(data).to.be.above(0);
       bru.setEnvVar("testProjectId", data);
    }
  });
}
