meta {
  name: 07 - Borrar Linea
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}{{apiBase}}/invoices/{{testInvoiceId}}/lines/{{testInvoiceLineId}}
  body: none
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
}

tests {
  test("Línea borrada exitosamente", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.lines.length).to.equal(1);
  });
}
