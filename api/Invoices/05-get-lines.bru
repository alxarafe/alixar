meta {
  name: 05 - Listar Lineas de Factura
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}{{apiBase}}/invoices/{{testInvoiceId}}/lines
  body: none
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
}

tests {
  test("Carga de lineas correcta", function() {
    expect(res.getStatus()).to.equal(200);
    const lines = res.getBody();
    expect(lines).to.be.an('array');
    expect(lines.length).to.equal(1);
    expect(Number(lines[0].id)).to.equal(bru.getVar("testInvoiceLineId"));
    expect(lines[0].desc).to.equal("Servicio de Consultoría");
  });
}
