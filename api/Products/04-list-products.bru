meta {
  name: 04-list-products
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}{{apiBase}}/products?limit=5
  body: none
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
}

tests {
  test("Listado existoso", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Devuelve array", function() {
    const data = res.getBody();
    expect(data).to.be.an('array');
    expect(data.length).to.be.at.most(5);
  });
}
