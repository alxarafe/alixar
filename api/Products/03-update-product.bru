meta {
  name: 03-update-product
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}{{apiBase}}/products/{{testProductId}}
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "label": "Producto de Test Actualizado",
    "price": "15.00",
    "price_ttc": "18.15",
    "tva_tx": "21.0"
  }
}

tests {
  test("Actualización exitosa", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
