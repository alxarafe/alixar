meta {
  name: 01 - Listar Notas de Gasto
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{apiBase}}/expensereports?sortfield=rowid&sortorder=ASC&limit=5&page=0
  body: none
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Accept: application/json
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Devuelve un array", function() {
    const body = res.getBody();
    expect(body).to.be.an("array");
  });
}
