meta {
  name: 01-create-order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiBase}}/orders
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "socid": 1,
    "ref_client": "CMD-001X",
    "note_private": "Express delivery"
  }
}

tests {
  test("Crea pedido exitoso", function() {
    expect([200, 201]).to.include(res.getStatus());
  });
  
  test("Devuelve id", function() {
    const data = res.getBody();
    if (typeof data === 'object' && data.id) {
       expect(data.id).to.be.above(0);
       bru.setEnvVar("testOrderId", data.id);
    } else {
       expect(data).to.be.above(0);
       bru.setEnvVar("testOrderId", data);
    }
  });
}
