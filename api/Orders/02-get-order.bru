meta {
  name: 02-get-order
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}{{apiBase}}/orders/{{testOrderId}}
  body: none
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
}

tests {
  test("Obtiene pedido exitosamente", function() {
    expect([200]).to.include(res.getStatus());
  });

  test("Los datos coinciden", function() {
    const data = res.getBody();
    expect(data.socid).to.equal(1);
    expect(data.ref_client).to.equal("CMD-001X");
    expect(data).to.have.property('lines');
  });
}
