meta {
  name: 04-update-supplierinvoice
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}{{apiBase}}/supplierinvoices/{{testSupplierInvoiceId}}
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "ref_supplier": "SINV-001X-UPD",
    "note_private": "Updated supplier invoice"
  }
}

tests {
  test("Actualización exitosa", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
