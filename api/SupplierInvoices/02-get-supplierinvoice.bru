meta {
  name: 02-get-supplierinvoice
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}{{apiBase}}/supplierinvoices/{{testSupplierInvoiceId}}
  body: none
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
}

tests {
  test("Obtiene factura exitosamente", function() {
    expect([200]).to.include(res.getStatus());
  });

  test("Los datos coinciden", function() {
    const data = res.getBody();
    expect(data.socid).to.equal(1);
    expect(data.ref_supplier).to.equal("SI-1455-X");
    expect(data).to.have.property('lines');
  });
}
