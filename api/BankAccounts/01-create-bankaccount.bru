meta {
  name: 01-create-bankaccount
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiBase}}/bankaccounts
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "ref": "BANK-01",
    "label": "Cuenta Principal BBVA",
    "bank": "BBVA",
    "iban_prefix": "ES1234567890123456789012",
    "currency_code": "EUR"
  }
}

tests {
  test("Crea Banco exitoso", function() {
    expect([200, 201]).to.include(res.getStatus());
  });
  
  test("Devuelve id", function() {
    const data = res.getBody();
    if (typeof data === 'object' && data.id) {
       expect(data.id).to.be.above(0);
       bru.setEnvVar("testBankAccountId", data.id);
    } else {
       expect(data).to.be.above(0);
       bru.setEnvVar("testBankAccountId", data);
    }
  });
}
