meta {
  name: 07 - Crear sin Apellido
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}{{apiBase}}/contacts
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "firstname": "SinApellido",
    "email": "sinape@test.es"
  }
}

tests {
  test("Status 4xx o 5xx (error de validación)", function() {
    const status = res.getStatus();
    expect(status >= 400).to.be.true;
  });
}
