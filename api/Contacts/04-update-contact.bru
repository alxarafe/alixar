meta {
  name: 04 - Actualizar Contacto
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}{{apiBase}}/contacts/{{testContactId}}
  body: json
  auth: none
}

headers {
  DOLAPIKEY: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "lastname": "BrunoContact Actualizado",
    "town": "Barcelona",
    "phone_pro": "918888888",
    "poste": "Lead Developer"
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Respuesta tiene el objeto actualizado", function() {
    const body = res.getBody();
    if (typeof body === 'object' && body !== null) {
      if (body.lastname) {
        expect(body.lastname).to.equal("BrunoContact Actualizado");
      }
    }
  });
}
