      <bpmndi:BPMNEdge id="Edge_O_F2" bpmnElement="O_F2"><di:waypoint x="170" y="335" /><di:waypoint x="170" y="245" /><di:waypoint x="260" y="245" /></bpmndi:BPMNEdge>
