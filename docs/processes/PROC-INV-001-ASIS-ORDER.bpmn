      <bpmndi:BPMNShape id="Shape_O_Draft" bpmnElement="O_Draft"><dc:Bounds x="1197" y="527" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_End" bpmnElement="O_End"><dc:Bounds x="1305" y="342" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_RouteNote" bpmnElement="O_RouteNote"><dc:Bounds x="120" y="35" width="470" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_RepeatNote" bpmnElement="O_RepeatNote"><dc:Bounds x="605" y="35" width="470" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_StockNote" bpmnElement="O_StockNote"><dc:Bounds x="1305" y="35" width="420" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_ContextNote" bpmnElement="O_ContextNote"><dc:Bounds x="40" y="650" width="450" height="110" /></bpmndi:BPMNShape>
