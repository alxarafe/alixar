      <bpmndi:BPMNEdge id="Edge_O_AssocO_RepeatNote" bpmnElement="O_AssocO_RepeatNote"><di:waypoint x="692.5" y="320" /><di:waypoint x="692.5" y="180" /><di:waypoint x="840" y="180" /><di:waypoint x="840" y="155" /></bpmndi:BPMNEdge>
