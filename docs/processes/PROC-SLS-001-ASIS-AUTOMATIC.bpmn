<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_PROC_SLS_001_ASIS_AUTOMATIC"
  targetNamespace="https://alixar.es/bpmn"
  exporter="Alixar"
  exporterVersion="1.0">
  <bpmn:process id="PROC-SLS-001-ASIS-AUTOMATIC" name="PROC-SLS-001 AS-IS automatic accepted proposal to order" isExecutable="false">
    <bpmn:documentation>AS-IS automatic path. Main path DEMOSTRADO in the commercial-ES profile; online-signature branch INFERIDO from source. AFS: AFS-PROC-002.</bpmn:documentation>

    <bpmn:startEvent id="StartEvent_CloseAccepted" name="Proposal closed as accepted">
      <bpmn:outgoing>Flow_Auto_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CloseProposal" name="Dolibarr: close proposal as accepted">
      <bpmn:incoming>Flow_Auto_01</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmitCloseEvent" name="Dolibarr: emit close-accepted event">
      <bpmn:incoming>Flow_Auto_02</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_AutocreateEnabled" name="Automatic option enabled?">
      <bpmn:incoming>Flow_Auto_03</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_Auto_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_NoAutomaticOrder" name="No automatic order">
      <bpmn:incoming>Flow_Auto_05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_OnlineSignature" name="Online signature context?">
      <bpmn:incoming>Flow_Auto_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_Auto_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_OrderPermission" name="Order creation permission?">
      <bpmn:incoming>Flow_Auto_07</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_Auto_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_NoPermission" name="No order created">
      <bpmn:incoming>Flow_Auto_09</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_OrderExists" name="Linked order exists?">
      <bpmn:incoming>Flow_Auto_06</bpmn:incoming>
      <bpmn:incoming>Flow_Auto_08</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_Auto_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_OrderExists" name="Order already exists">
      <bpmn:incoming>Flow_Auto_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_CreateOrderFromProposal" name="Dolibarr: create order from proposal">
      <bpmn:incoming>Flow_Auto_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ValidateAfterClose" name="Validate after close?">
      <bpmn:incoming>Flow_Auto_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_Auto_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ValidateOrder" name="Dolibarr: validate order">
      <bpmn:incoming>Flow_Auto_13</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_OrderValidated" name="Order validated">
      <bpmn:incoming>Flow_Auto_15</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_OrderDraft" name="Order in draft">
      <bpmn:incoming>Flow_Auto_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Auto_01" sourceRef="StartEvent_CloseAccepted" targetRef="Task_CloseProposal" />
    <bpmn:sequenceFlow id="Flow_Auto_02" sourceRef="Task_CloseProposal" targetRef="Task_EmitCloseEvent" />
    <bpmn:sequenceFlow id="Flow_Auto_03" sourceRef="Task_EmitCloseEvent" targetRef="Gateway_AutocreateEnabled" />
    <bpmn:sequenceFlow id="Flow_Auto_04" name="Yes" sourceRef="Gateway_AutocreateEnabled" targetRef="Gateway_OnlineSignature">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Workflow module active and WORKFLOW_PROPAL_AUTOCREATE_ORDER enabled</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_05" name="No" sourceRef="Gateway_AutocreateEnabled" targetRef="EndEvent_NoAutomaticOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Workflow module inactive or automatic option disabled</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_06" name="Yes" sourceRef="Gateway_OnlineSignature" targetRef="Gateway_OrderExists">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Proposal context contains closedfromonlinesignature</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_07" name="No" sourceRef="Gateway_OnlineSignature" targetRef="Gateway_OrderPermission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No online-signature context</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_08" name="Yes" sourceRef="Gateway_OrderPermission" targetRef="Gateway_OrderExists">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">User has order creation permission</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_09" name="No" sourceRef="Gateway_OrderPermission" targetRef="EndEvent_NoPermission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">User lacks order creation permission</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_10" name="No" sourceRef="Gateway_OrderExists" targetRef="Task_CreateOrderFromProposal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No linked order exists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_11" name="Yes" sourceRef="Gateway_OrderExists" targetRef="EndEvent_OrderExists">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">A linked order already exists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_12" sourceRef="Task_CreateOrderFromProposal" targetRef="Gateway_ValidateAfterClose" />
    <bpmn:sequenceFlow id="Flow_Auto_13" name="Yes" sourceRef="Gateway_ValidateAfterClose" targetRef="Task_ValidateOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ORDER_VALID_AFTER_CLOSE_PROPAL enabled</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_14" name="No" sourceRef="Gateway_ValidateAfterClose" targetRef="EndEvent_OrderDraft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ORDER_VALID_AFTER_CLOSE_PROPAL disabled</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_15" sourceRef="Task_ValidateOrder" targetRef="EndEvent_OrderValidated" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_PROC_SLS_001_ASIS_AUTOMATIC">
    <bpmndi:BPMNPlane id="BPMNPlane_PROC_SLS_001_ASIS_AUTOMATIC" bpmnElement="PROC-SLS-001-ASIS-AUTOMATIC">
      <bpmndi:BPMNShape id="Shape_StartEvent_CloseAccepted" bpmnElement="StartEvent_CloseAccepted">
        <dc:Bounds x="152" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CloseProposal" bpmnElement="Task_CloseProposal">
        <dc:Bounds x="240" y="180" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EmitCloseEvent" bpmnElement="Task_EmitCloseEvent">
        <dc:Bounds x="420" y="180" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_AutocreateEnabled" bpmnElement="Gateway_AutocreateEnabled" isMarkerVisible="true">
        <dc:Bounds x="620" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_NoAutomaticOrder" bpmnElement="EndEvent_NoAutomaticOrder">
        <dc:Bounds x="660" y="420" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OnlineSignature" bpmnElement="Gateway_OnlineSignature" isMarkerVisible="true">
        <dc:Bounds x="720" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="670" y="150" width="150" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OrderPermission" bpmnElement="Gateway_OrderPermission" isMarkerVisible="true">
        <dc:Bounds x="720" y="300" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_NoPermission" bpmnElement="EndEvent_NoPermission">
        <dc:Bounds x="820" y="420" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OrderExists" bpmnElement="Gateway_OrderExists" isMarkerVisible="true">
        <dc:Bounds x="920" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_OrderExists" bpmnElement="EndEvent_OrderExists">
        <dc:Bounds x="1020" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CreateOrderFromProposal" bpmnElement="Task_CreateOrderFromProposal">
        <dc:Bounds x="1020" y="180" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ValidateAfterClose" bpmnElement="Gateway_ValidateAfterClose" isMarkerVisible="true">
        <dc:Bounds x="1220" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValidateOrder" bpmnElement="Task_ValidateOrder">
        <dc:Bounds x="1320" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_OrderValidated" bpmnElement="EndEvent_OrderValidated">
        <dc:Bounds x="1480" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_OrderDraft" bpmnElement="EndEvent_OrderDraft">
        <dc:Bounds x="1480" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_Auto_01" bpmnElement="Flow_Auto_01">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_02" bpmnElement="Flow_Auto_02">
        <di:waypoint x="380" y="220" />
        <di:waypoint x="420" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_03" bpmnElement="Flow_Auto_03">
        <di:waypoint x="580" y="220" />
        <di:waypoint x="620" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_04" bpmnElement="Flow_Auto_04">
        <di:waypoint x="670" y="220" />
        <di:waypoint x="720" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_05" bpmnElement="Flow_Auto_05">
        <di:waypoint x="645" y="245" />
        <di:waypoint x="645" y="438" />
        <di:waypoint x="660" y="438" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_06" bpmnElement="Flow_Auto_06">
        <di:waypoint x="770" y="220" />
        <di:waypoint x="920" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_07" bpmnElement="Flow_Auto_07">
        <di:waypoint x="745" y="245" />
        <di:waypoint x="745" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_08" bpmnElement="Flow_Auto_08">
        <di:waypoint x="770" y="325" />
        <di:waypoint x="945" y="325" />
        <di:waypoint x="945" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_09" bpmnElement="Flow_Auto_09">
        <di:waypoint x="770" y="325" />
        <di:waypoint x="795" y="325" />
        <di:waypoint x="795" y="438" />
        <di:waypoint x="820" y="438" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_10" bpmnElement="Flow_Auto_10">
        <di:waypoint x="970" y="220" />
        <di:waypoint x="1020" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_11" bpmnElement="Flow_Auto_11">
        <di:waypoint x="945" y="245" />
        <di:waypoint x="945" y="338" />
        <di:waypoint x="1020" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_12" bpmnElement="Flow_Auto_12">
        <di:waypoint x="1180" y="220" />
        <di:waypoint x="1220" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_13" bpmnElement="Flow_Auto_13">
        <di:waypoint x="1270" y="220" />
        <di:waypoint x="1320" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_14" bpmnElement="Flow_Auto_14">
        <di:waypoint x="1245" y="245" />
        <di:waypoint x="1245" y="318" />
        <di:waypoint x="1480" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Auto_15" bpmnElement="Flow_Auto_15">
        <di:waypoint x="1440" y="220" />
        <di:waypoint x="1480" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
