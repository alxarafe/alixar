{
    "name": "alxarafe/alixar",
    "description": "Alixar ERP using Alxarafe Framework",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "flightphp/core": "^3.0",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^2.1",
        "php-debugbar/php-debugbar": "^3.3",
        "phpmd/phpmd": "^2.15",
        "phpmetrics/phpmetrics": "^2.9",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "src/",
            "Plugin\\Crm\\": "plugins/crm/src/",
            "Plugin\\Business\\": "plugins/business/src/",
            "Plugin\\Trading\\": "plugins/trading/src/",
            "Plugin\\Products\\": "plugins/products/src/",
            "Plugin\\Projects\\": "plugins/projects/src/",
            "Plugin\\Finance\\": "plugins/finance/src/",
            "Plugin\\Tenant\\": "plugins/tenant/src/",
            "Plugin\\DolibarrCompat\\": "plugins/dolibarr-compat/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "bash bin/test.sh",
        "test:api": "bash bin/api_compare.sh all"
    }
}
